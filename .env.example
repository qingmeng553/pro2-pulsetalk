# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会进仓库）
# 图片对外地址：浏览器访问站点用的地址 + /files
MINIO_PUBLIC_ENDPOINT=http://<服务器公网IP或域名>/files

# 可选：MinIO 凭据与内部地址（默认值见 docker-compose.yml）
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123

# 邮件（生产必填；本地用 MailHog 时保持默认 mailhog:1025 即可）
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your@163.com
MAIL_PASSWORD=你的163客户端授权码
MAIL_FROM=PulseTalk <your@163.com>
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false