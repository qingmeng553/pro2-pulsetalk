# ============================================================================
# PulseTalk 生产环境变量样例
# 用法：cp deploy/.env.prod.example deploy/.env.prod  然后按需修改
# 引用：docker compose --env-file deploy/.env.prod -f docker-compose.yml \
#       -f deploy/docker-compose.prod.yml up -d --build
# ============================================================================

# ---- 必改：数据库/对象存储口令(请换成强密码并妥善保存) ----
MYSQL_ROOT_PASSWORD=请改成强密码

MINIO_ACCESS_KEY=请改成非minioadmin的账号
MINIO_SECRET_KEY=请改成强密码

# Redis 密码(留空表示不启用；容器内网可选)
REDIS_PASSWORD=

# ---- 图片地址前缀：固定 /files，由 Nginx 反代到 MinIO ----
# 一般不需要改；只有图片要直连其他对象存储域名时才覆盖。
MINIO_PUBLIC_ENDPOINT=/files

# ---- 邮件（163 SMTP：密码是“客户端授权码”，不是登录密码）----
# 例：MAIL_USERNAME=pulsetalk@163.com
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=你的163邮箱
MAIL_PASSWORD=你的163客户端授权码
MAIL_FROM=PulseTalk <你的163邮箱>
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
MAIL_SMTP_STARTTLS=false
